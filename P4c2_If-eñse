        if (distancia <= 1) {
            System.out.println("Puedes caminar.");
        } else if (distancia <= 5) {
            System.out.println("Puedes ir en bicicleta.");
        } else {
            System.out.println("Puedes ir en coche.");
        }
    }
    
    // Ejercicio 10: Sugerir actividad según temperatura
